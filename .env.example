# NAS SMB Configuration
NAS_HOST=your-nas-hostname-or-ip
NAS_SHARE=your-share-name
SMB_USER=your-smb-username
SMB_PASS=your-smb-password

# Ollama / LLM configuration (used by docker-compose.host.yml and backend)
# Example model names depend on what you have available in Ollama. Lower-capacity models are faster.
# Set OLLAMA_MODEL to a smaller model to speed up inference (if available locally):
# e.g. llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
# Maximum tokens to generate (lower -> faster)
OLLAMA_MAX_TOKENS=256
# Model temperature (0.0 deterministic)
OLLAMA_TEMPERATURE=0.0
# Ollama client timeout (seconds)
OLLAMA_TIMEOUT=600